{
  "name": "food-deals",
  "version": "1.0.0",
  "description": "Find the cheapest food and best offers across Swiggy and Zomato, with an AI deal finder.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "vite build",
    "dev": "concurrently -k -n api,web -c green,magenta \"APP_URL=http://localhost:5173 node --watch server.js\" \"vite\"",
    "dev:api": "node --watch server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
